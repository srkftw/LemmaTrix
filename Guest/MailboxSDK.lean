import Guest.LiveSDK
namespace Guest.MailboxSDK
open Guest.LiveSDK
-- Canonical public maxima. Recipients may choose stricter byte/operation
-- allowances. Contract1 is bounded retention without a civil-time promise.
def receiptTerms (p t : UInt64) : UInt64 :=
  let t := store64 p 1 (store64 (p+8) 1 t)
  let t := store64 (p+16) 8388608 (store64 (p+24) 65536 t)
  let t := store64 (p+32) 8192 (store64 (p+40) 16 t)
  store64 (p+48) 8 (store64 (p+56) 1 t)
-- Mailbox-v1 is a terminal-stream protocol. The broker must carry this whole
-- request inside its protected terminal stream; relay headers contain no token.
-- Administrative440 and terminal441 are separate exact kernel operation grants.
def invoke (operation length t : UInt64) : UInt64 :=
  let target := syscall 128 3 operation 0 0 t
  if target == error then error else syscall 30 target wire length 1024 target
def configure (storeGrant t : UInt64) : UInt64 :=
  invoke 440 64 (header 440 0 storeGrant 0 0 0 0 t)
-- id32, SHA256(deposit token)32, SHA256(fetch token)32. Tokens are generated by
-- the recipient secret owner and conveyed privately, never by this operator.
def enroll (publicAuthority byteLimit attemptLimit t : UInt64) : UInt64 :=
  let t := header 440 1 byteLimit attemptLimit 0 0 0 t
  invoke 440 160 (copy publicAuthority (wire+64) 96 t)
def inventory (index t : UInt64) : UInt64 :=
  invoke 440 64 (header 440 2 index 0 0 0 0 t)
def revoke (id t : UInt64) : UInt64 :=
  invoke 440 96 (copy id (wire+64) 32 (header 440 3 0 0 0 0 0 t))
def configureReceipts (grant profile t : UInt64) : UInt64 :=
  invoke 440 480 (copy profile (wire+64) 416 (header 440 4 grant 0 0 0 0 t))
def rotateReceiptProfile (t : UInt64) : UInt64 := invoke 440 64 (header 440 5 0 0 0 0 0 t)
def receiptProfile (t : UInt64) : UInt64 := invoke 441 64 (header 441 10 0 0 0 0 0 t)
-- Admission body: mailbox id32, deposit token32, request id32, ciphertext
-- SHA25632. An unknown retry after dedup eviction requires fresh admission.
def begin (authority bytes fresh t : UInt64) : UInt64 :=
  let t := header 441 1 bytes fresh 0 0 0 t
  invoke 441 192 (copy authority (wire+64) 128 t)
def append (authority handle offset source bytes t : UInt64) : UInt64 :=
  if bytes == 0 || bytes > 512 then error else
  let t := header 441 2 handle offset 0 0 0 t
  let t := copy authority (wire+64) 64 t
  invoke 441 (128+bytes) (copy source (wire+128) bytes t)
def commit (authority handle t : UInt64) : UInt64 :=
  invoke 441 128 (copy authority (wire+64) 64 (header 441 3 handle 0 0 0 0 t))
def poll (authority handle t : UInt64) : UInt64 :=
  let t := header 441 4 handle 0 0 0 0 t
  if handle == 0 then invoke 441 64 t else invoke 441 128 (copy authority (wire+64) 64 t)
-- Fetch body: id32, fetch token32. Cursor is a stable allocation handle, zero
-- means oldest accepted envelope. Payload chunks are bounded to512 bytes.
def fetch (authority cursor offset bytes t : UInt64) : UInt64 :=
  let t := header 441 5 cursor offset bytes 0 0 t
  invoke 441 128 (copy authority (wire+64) 64 t)
-- Skip parked ciphertext without granting enumeration of another recipient.
def fetchNext (authority after bytes t : UInt64) : UInt64 :=
  let t := header 441 5 0 0 bytes after 0 t
  invoke 441 128 (copy authority (wire+64) 64 t)
-- Ack also binds the exact ciphertext commitment. It is called only after the
-- recipient has committed authenticated session/inbox state.
def acknowledge (authority handle commitment t : UInt64) : UInt64 :=
  let t := header 441 6 handle 0 0 0 0 t
  let t := copy authority (wire+64) 64 t
  invoke 441 160 (copy commitment (wire+128) 32 t)
def cancel (authority handle t : UInt64) : UInt64 :=
  invoke 441 128 (copy authority (wire+64) 64 (header 441 7 handle 0 0 0 0 t))
def publishPrekey (authority bundle t : UInt64) : UInt64 :=
  let t := header 441 8 0 0 0 0 0 t
  let t := copy authority (wire+64) 64 t
  invoke 441 384 (copy bundle (wire+128) 256 t)
-- A public prekey claim never authorizes destruction of its private key. The
-- secret owner waits for authenticated initial-message/session publication.
def claimPrekey (authority request t : UInt64) : UInt64 :=
  let t := header 441 9 0 0 0 0 0 t
  let t := copy authority (wire+64) 64 t
  invoke 441 160 (copy request (wire+128) 32 t)
end Guest.MailboxSDK
